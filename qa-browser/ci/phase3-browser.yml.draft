# Read-only candidate QA template for the explicitly approved public repository.
# The release workflow may use the same browser job before its separate Pages job.
name: Inner Zoo browser acceptance
on:
  push:
    branches: ['main']
    paths:
      - 'src/**'
      - 'assets/avatars/web/**'
      - 'scripts/**'
      - 'qa-browser/**'
      - 'package.json'
      - '.github/workflows/**'
  workflow_dispatch:
permissions:
  contents: read
concurrency:
  group: inner-zoo-browser-${{ github.ref }}
  cancel-in-progress: false
jobs:
  browser:
    if: ${{ github.repository == 'zyrobbie/inner-zoo' && !github.event.repository.private && github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    defaults:
      run:
        working-directory: qa-browser
        shell: bash
    env:
      CI: 'true'
      ZOO_PROJECT_ROOT: ${{ github.workspace }}
      PLAYWRIGHT_BROWSERS_PATH: ${{ runner.temp }}/zoo-pw-browsers
    steps:
      - name: Read approved source snapshot
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          fetch-depth: 1
      - name: Node runtime
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: '22'
      - name: Install exact QA dependencies
        run: npm ci --ignore-scripts --no-fund --no-audit
      - name: Static QA wiring checks
        run: npm run check:draft
      - name: Build complete dist from the original build scripts
        working-directory: .
        run: |
          mkdir -p dist
          cd src
          node build-mc.js
          mv quiz-mc.html ../dist/
          cd ..
          node src/build-standalone.js
      - name: Freeze exact tested dist hashes
        run: |
          npm run preflight
          node -p 'JSON.stringify({node:process.version,platform:process.platform,arch:process.arch,playwright:require("@playwright/test/package.json").version})' > artifacts/runner-runtime.json
      - name: Install only Chromium and WebKit
        run: npx --no-install playwright install --with-deps chromium webkit
      - name: Discover real Playwright tests
        run: npm run test:list
      - name: Run 29 candidate tests on runner loopback
        run: npm test
      - name: Preserve synthetic test evidence on failure or success
        if: ${{ always() }}
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: browser-evidence-${{ github.sha }}-${{ github.run_attempt }}
          path: qa-browser/artifacts/
          if-no-files-found: warn
          retention-days: 3
          compression-level: 6
          include-hidden-files: false
